# ==============================================================================
# TravelApp — root environment template
# Copy to `.env` (or use the Compose `.env`) and fill in real values.
# For local dev, the backend reads backend/.env; see backend/.env.example.
# ==============================================================================

# --- Postgres (used by docker-compose to provision the db container) ---
POSTGRES_USER=travel
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=travelapp

# --- Backend API ---
DATABASE_URL=postgresql://travel:change_me_strong_password@db:5432/travelapp?schema=public
JWT_SECRET=change_me_to_a_long_random_string
PORT=3000
# Opt-in structured diagnostic logs; request/confirmation bodies and secrets are excluded.
DEBUG_LOGGING=false
# Absolute path inside the api container where uploads are written
UPLOAD_DIR=/data/uploads
# Base URL used to build public photo URLs (web proxy -> api)
PUBLIC_BASE_URL=http://localhost:8070

# --- Auth bootstrap ---
# On first run, the app seeds an admin account from these values (create the
# .env with these lines, run migrations, then start).
BOOTSTRAP_EMAIL=admin@example.com
BOOTSTRAP_PASSWORD=change_me_admin_password
BOOTSTRAP_NAME=Admin

# --- Email itinerary import (Gmail/Google Workspace IMAP + App Password) ---
EMAIL_ENABLED=false
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=
IMAP_FOLDER=INBOX
IMAP_POLL_MINUTES=5
# Only process these senders (comma-separated substrings). Empty = process all.
EMAIL_ALLOWLIST=
# Set to false during initial setup to avoid pulling the entire history.
IMPORT_UNSEEN_FIRST=true

# --- AI assistant (OpenAI-compatible endpoint) ---
AI_ENABLED=false
# URL reachable from the api container. Open WebUI http://open-webui:8080 / Ollama http://<host-ip>:11434
AI_BASE_URL=http://open-webui:8080
AI_API_KEY=
AI_MODEL=llama3
AI_TIMEOUT_MS=120000

# --- Suggestions (things to do/see) ---
# Google Places API (New) key. Keep this only in .env; never commit a real key.
# Provides rated, relevant local recommendations; OpenStreetMap remains the fallback.
GOOGLE_PLACES_API_KEY=
# SearXNG instance used for general web recommendations.
SEARCH_ENABLED=true
SEARXNG_URL=http://searxng:8080
SEARCH_TIMEOUT_MS=10000