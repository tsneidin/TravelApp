generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MemberRole {
  owner
  editor
  viewer
}

enum BookingType {
  flight
  hotel
  car
  activity
}

enum ExpenseCategory {
  transport
  lodging
  food
  activity
  shopping
  entertainment
  other
}

enum ImportStatus {
  pending
  parsed
  needs_review
  imported
  ignored
  failed
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  isAdmin      Boolean  @default(false)
  createdAt    DateTime @default(now())

  memberships TripMember[]
  ownsTrips   Trip[]         @relation("Owner")
  photos      Photo[]
  journal     JournalEntry[]
  expenses    Expense[]
  imports     EmailImport[]
  bookings    Booking[]
  chat        ChatMessage[]
}

model Trip {
  id          String    @id @default(cuid())
  name        String
  destination String
  description String?
  coverUrl    String?
  currency    String    @default("USD")
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  owner    User           @relation("Owner", fields: [ownerId], references: [id])
  ownerId  String
  members  TripMember[]
  days     Day[]
  places   Place[]
  photos   Photo[]
  journal  JournalEntry[]
  expenses Expense[]
  packing  PackingItem[]
  bookings Booking[]
  imports  EmailImport[]
  chat     ChatMessage[]

  @@index([ownerId])
}

model TripMember {
  id        String     @id @default(cuid())
  role      MemberRole @default(viewer)
  createdAt DateTime   @default(now())

  user   User   @relation(fields: [userId], references: [id])
  userId String
  trip   Trip   @relation(fields: [tripId], references: [id])
  tripId String

  @@unique([tripId, userId])
  @@index([userId])
}

model Day {
  id        String   @id @default(cuid())
  label     String?
  date      DateTime
  notes     String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  trip   Trip    @relation(fields: [tripId], references: [id])
  tripId String
  places Place[]

  @@index([tripId])
}

model Place {
  id        String   @id @default(cuid())
  name      String
  category  String?
  address   String?
  lat       Float?
  lng       Float?
  notes     String?
  website   String?
  sourceText String?
  startTime DateTime?
  endTime   DateTime?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  trip     Trip      @relation(fields: [tripId], references: [id])
  tripId   String
  day      Day?      @relation(fields: [dayId], references: [id], onDelete: SetNull)
  dayId    String?
  photos   Photo[]
  expenses Expense[]
  bookings Booking[]

  @@index([tripId])
  @@index([dayId])
}

model Photo {
  id        String   @id @default(cuid())
  filename  String
  caption   String?
  mimeType  String?
  size      Int?
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id])
  userId  String
  trip    Trip    @relation(fields: [tripId], references: [id])
  tripId  String
  place   Place?  @relation(fields: [placeId], references: [id], onDelete: SetNull)
  placeId String?
}

model JournalEntry {
  id        String   @id @default(cuid())
  title     String
  body      String
  date      DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User  @relation(fields: [userId], references: [id])
  userId String
  trip   Trip  @relation(fields: [tripId], references: [id])
  tripId String

  @@index([tripId])
}

model Expense {
  id          String          @id @default(cuid())
  description String
  category    ExpenseCategory @default(other)
  amount      Float
  currency    String          @default("USD")
  date        DateTime?
  createdAt   DateTime        @default(now())

  trip    Trip    @relation(fields: [tripId], references: [id])
  tripId  String
  user    User    @relation(fields: [userId], references: [id])
  userId  String
  place   Place?  @relation(fields: [placeId], references: [id], onDelete: SetNull)
  placeId String?

  @@index([tripId])
}

model PackingItem {
  id        String  @id @default(cuid())
  category  String?
  item      String
  done      Boolean @default(false)
  sortOrder Int     @default(0)
  createdAt DateTime @default(now())

  trip   Trip  @relation(fields: [tripId], references: [id])
  tripId String

  @@index([tripId])
}

model Booking {
  id             String      @id @default(cuid())
  type           BookingType
  title          String
  provider       String?
  reference      String?
  startAt        DateTime?
  endAt          DateTime?
  details        Json?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  trip           Trip        @relation(fields: [tripId], references: [id])
  tripId         String
  user           User?       @relation(fields: [userId], references: [id])
  userId         String?
  sourceImportId String?
  place          Place?      @relation(fields: [placeId], references: [id], onDelete: SetNull)
  placeId        String?

  @@index([tripId])
}

model EmailImport {
  id            String       @id @default(cuid())
  messageId     String       @unique
  from          String
  to            String?
  subject       String
  bodyText      String?
  bodyHtml      String?
  headers       Json?
  status        ImportStatus @default(pending)
  type          BookingType?
  parsedPayload Json?
  error         String?
  assignedAt    DateTime?
  createdAt     DateTime @default(now())

  trip    Trip?    @relation(fields: [tripId], references: [id])
  tripId  String?
  user    User?    @relation(fields: [userId], references: [id])
  userId String?

  @@index([tripId])
  @@index([status])
}

model ChatMessage {
  id        String   @id @default(cuid())
  role      String
  content   String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  userId String
  trip   Trip?  @relation(fields: [tripId], references: [id], onDelete: Cascade)
  tripId String?

  @@index([tripId, createdAt])
  @@index([userId, createdAt])
}