# Backend environment template — copy to `.env` and edit.
# NOTE: For local dev, `DATABASE_URL` should point at your local Postgres.
# For Compose deployment, these same vars are set via the root compose env.

DATABASE_URL=postgresql://travel:change_me_strong_password@localhost:5432/travelapp?schema=public
JWT_SECRET=change_me_to_a_long_random_string
PORT=3000
UPLOAD_DIR=./uploads
PUBLIC_BASE_URL=http://localhost:8070

# Bootstrap admin (created on first start if no users exist)
BOOTSTRAP_EMAIL=admin@example.com
BOOTSTRAP_PASSWORD=change_me_admin_password
BOOTSTRAP_NAME=Admin

# Email itinerary import
EMAIL_ENABLED=false
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=
IMAP_FOLDER=INBOX
IMAP_POLL_MINUTES=5
EMAIL_ALLOWLIST=
IMPORT_UNSEEN_FIRST=true